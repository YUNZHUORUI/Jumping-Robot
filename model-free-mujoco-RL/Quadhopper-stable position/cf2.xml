<mujoco model="cf2">
  <option integrator="RK4" density="1.225" viscosity="1.8e-5"/>
  <compiler inertiafromgeom="false" meshdir="assets" autolimits="true"/>

  <default>
    <default class="cf2">
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="mesh"/>
      </default>
      <site group="5"/>
    </default>
  </default>

  <asset>
    <material name="polished_plastic" rgba="0.631 0.659 0.678 1"/>
    <material name="polished_gold" rgba="0.969 0.878 0.6 1"/>
    <material name="medium_gloss_plastic" rgba="0.109 0.184 0.0 1"/>
    <material name="propeller_plastic" rgba="0.792 0.820 0.933 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="body_frame_plastic" rgba="0.102 0.102 0.102 1"/>
    <material name="burnished_chrome" rgba="0.898 0.898 0.898 1"/>

    <mesh file="cf2_0.obj" scale="5 5 5"/>
    <mesh file="cf2_1.obj" scale="5 5 5"/>
    <mesh file="cf2_2.obj" scale="5 5 5"/>
    <mesh file="cf2_3.obj" scale="5 5 5"/>
    <mesh file="cf2_4.obj" scale="5 5 5"/>
    <mesh file="cf2_5.obj" scale="5 5 5"/>
    <mesh file="cf2_6.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_0.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_1.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_2.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_3.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_4.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_5.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_6.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_7.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_8.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_9.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_10.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_11.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_12.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_13.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_14.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_15.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_16.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_17.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_18.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_19.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_20.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_21.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_22.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_23.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_24.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_25.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_26.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_27.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_28.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_29.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_30.obj" scale="5 5 5"/>
    <mesh file="cf2_collision_31.obj" scale="5 5 5"/>
  </asset>

  <worldbody>
    <body name="quadcopter" pos="0 0 2.0" euler="0 0 0" childclass="cf2">
      <freejoint/>

      <inertial pos="0 0 0" mass="1.1" diaginertia="0.15 0.15 0.3"/>

      <camera name="track" pos="-2 0 1" xyaxes="0 -1 0 1 0 2" mode="trackcom"/>

      <geom mesh="cf2_0" material="propeller_plastic" class="visual"/>
      <geom mesh="cf2_1" material="medium_gloss_plastic" class="visual"/>
      <geom mesh="cf2_2" material="polished_gold" class="visual"/>
      <geom mesh="cf2_3" material="polished_plastic" class="visual"/>
      <geom mesh="cf2_4" material="burnished_chrome" class="visual"/>
      <geom mesh="cf2_5" material="body_frame_plastic" class="visual"/>
      <geom mesh="cf2_6" material="white" class="visual"/>

      <geom mesh="cf2_collision_0" class="collision"/>
      <geom mesh="cf2_collision_1" class="collision"/>
      <geom mesh="cf2_collision_2" class="collision"/>
      <geom mesh="cf2_collision_3" class="collision"/>
      <geom mesh="cf2_collision_4" class="collision"/>
      <geom mesh="cf2_collision_5" class="collision"/>
      <geom mesh="cf2_collision_6" class="collision"/>
      <geom mesh="cf2_collision_7" class="collision"/>
      <geom mesh="cf2_collision_8" class="collision"/>
      <geom mesh="cf2_collision_9" class="collision"/>
      <geom mesh="cf2_collision_10" class="collision"/>
      <geom mesh="cf2_collision_11" class="collision"/>
      <geom mesh="cf2_collision_12" class="collision"/>
      <geom mesh="cf2_collision_13" class="collision"/>
      <geom mesh="cf2_collision_14" class="collision"/>
      <geom mesh="cf2_collision_15" class="collision"/>
      <geom mesh="cf2_collision_16" class="collision"/>
      <geom mesh="cf2_collision_17" class="collision"/>
      <geom mesh="cf2_collision_18" class="collision"/>
      <geom mesh="cf2_collision_19" class="collision"/>
      <geom mesh="cf2_collision_20" class="collision"/>
      <geom mesh="cf2_collision_21" class="collision"/>
      <geom mesh="cf2_collision_22" class="collision"/>
      <geom mesh="cf2_collision_23" class="collision"/>
      <geom mesh="cf2_collision_24" class="collision"/>
      <geom mesh="cf2_collision_25" class="collision"/>
      <geom mesh="cf2_collision_26" class="collision"/>
      <geom mesh="cf2_collision_27" class="collision"/>
      <geom mesh="cf2_collision_28" class="collision"/>
      <geom mesh="cf2_collision_29" class="collision"/>
      <geom mesh="cf2_collision_30" class="collision"/>
      <geom mesh="cf2_collision_31" class="collision"/>

      <site name="imu"/>

      <site name="motor1_site" pos="0.1768 0.1768 0.05"/>
      <site name="motor2_site" pos="0.1768 -0.1768 0.05"/>
      <site name="motor3_site" pos="-0.1768 -0.1768 0.05"/>
      <site name="motor4_site" pos="-0.1768 0.1768 0.05"/>

      <site name="drone_attach" pos="0 0 0" size="0.01"/>

      <body name="foot" pos="0 0 -1.0">
        <joint name="ball_joint" type="slide" axis="0 0 1" damping="0.0"/>
        <inertial pos="0 0 0" mass="0.11" diaginertia="0.001 0.001 0.001"/>
        <geom name="lower_sphere" type="sphere" size="0.05" rgba="0 0 1 1"
              condim="3"
              friction="2.5 0.005 0.0001"
              margin="0.002"/>
        <site name="lower_site" pos="0 0 0" size="0.01"/>
      </body>

    </body>
  </worldbody>

  <tendon>
    <spatial name="spring"
             stiffness="150"
             damping="1"
             width="0.015"
             rgba="1 0 0 1">
      <site site="drone_attach"/>
      <site site="lower_site"/>
    </spatial>
  </tendon>

  <actuator>
    <motor class="cf2" ctrlrange="0 1" gear="0 0 15.0 0 0 -0.4" site="motor1_site" name="motor1"/>
    <motor class="cf2" ctrlrange="0 1" gear="0 0 15.0 0 0 0.4" site="motor2_site" name="motor2"/>
    <motor class="cf2" ctrlrange="0 1" gear="0 0 15.0 0 0 -0.4" site="motor3_site" name="motor3"/>
    <motor class="cf2" ctrlrange="0 1" gear="0 0 15.0 0 0 0.4" site="motor4_site" name="motor4"/>
  </actuator>

  <sensor>
    <gyro name="body_gyro" site="imu"/>
    <accelerometer name="body_linacc" site="imu"/>
    <framequat name="body_quat" objtype="site" objname="imu"/>
  </sensor>
</mujoco>